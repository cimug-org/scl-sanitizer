    <DOType cdc="MV" id="MV_RMS" desc="Measured value (MV)">
      <DA dchg="true" dupd="true" fc="MX" name="mag" bType="Struct" type="AnalogueValue_f" desc="Deadbanded value. Shall be based on a dead band calculation from instMag as illustrated below. The value of mag shall be updated to the current value of instMag when the value has changed according the configuration parameter db. NOTE 7 The figure above is an example. There may be other algorithms providing a comparable result; for example as an alternate solution, the dead band calculation may use the integral of the change of instMag. The algorithm used is a local issue. NOTE 8 This value mag is typically used to create reports for analogue values. Such a report sent by exception is not comparable to the transfer of sampled measured values as supported by the CDC SAV." />
      <DA qchg="true" fc="MX" name="q" bType="Quality" desc="Quality of the attribute(s) representing the value of the data." />
      <DA fc="MX" name="t" bType="Timestamp" desc="Timestamp of the last change in one of the attribute(s) representing the value of the data or in the q attribute." />
      <DA dchg="true" fc="CF" name="units" bType="Struct" type="Unit_V001" desc="Units of the attribute(s) representing the value of the data." />
      <DA fc="DC" name="d" bType="VisString255" valKind="RO" valImport="false" desc="Textual desc of the data. In case of the common data class LPL, the desc refers to the logical node.">
        <Val>Not used in TMUs</Val>
      </DA>
    </DOType>
    <DOType cdc="MV" id="MV_RMS_COMPLETE" desc="Measured value (MV)">
      <DA dchg="true" dupd="true" fc="MX" name="mag" bType="Struct" type="AnalogueValue_f" desc="Deadbanded value. Shall be based on a dead band calculation from instMag as illustrated below. The value of mag shall be updated to the current value of instMag when the value has changed according the configuration parameter db. NOTE 7 The figure above is an example. There may be other algorithms providing a comparable result; for example as an alternate solution, the dead band calculation may use the integral of the change of instMag. The algorithm used is a local issue. NOTE 8 This value mag is typically used to create reports for analogue values. Such a report sent by exception is not comparable to the transfer of sampled measured values as supported by the CDC SAV." />
      <DA qchg="true" fc="MX" name="q" bType="Quality" desc="Quality of the attribute(s) representing the value of the data." />
      <DA fc="MX" name="t" bType="Timestamp" desc="Timestamp of the last change in one of the attribute(s) representing the value of the data or in the q attribute." />
      <DA dchg="true" fc="CF" name="units" bType="Struct" type="Unit_V001" desc="Units of the attribute(s) representing the value of the data." />
      <DA dchg="true" fc="CF" name="smpRate" bType="INT32U" desc="Sampling rate that has been used to determine the analogue values. The value shall represent the number of samples per nominal period. In the case of a d.c. system, the value shall represent the number of samples per s." />
      <DA dchg="true" fc="CF" name="rangeC" bType="Struct" type="RangeConfig" desc="Range configuration type is used to configure the limits that define the range of a measured value" />
