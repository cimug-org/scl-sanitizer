              <SDI name="units">
                <DAI name="SIUnit" valKind="RO" valImport="false">
                  <Val />
                </DAI>
                <DAI name="multiplier" valKind="RO" valImport="false">
                  <Val />
                </DAI>
              </SDI>
              <DAI name="setVal" valKind="RO" valImport="true">
                <Val>24</Val>
              </DAI>
              <DAI name="minVal" valKind="RO" valImport="false">
                <Val>0</Val>
              </DAI>
              <DAI name="maxVal" valKind="RO" valImport="false">
