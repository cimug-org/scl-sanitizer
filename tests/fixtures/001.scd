      <DA fc="ST" name="t" bType="Timestamp" desc="Timestamp of the last change in one of the attribute(s) representing the value of the data or in the q attribute." />
      <DA qchg="false" dupd="false" fc="ST" name="originSrc" bType="Struct" type="SE_Originator_P5_V001" desc="Contains the information related to the originator of a control action forwarded by a GOOSE message." />
      <DA fc="DC" name="d" bType="VisString255" valKind="RO" valImport="false" desc="Textual desc of the data. In case of the common data class LPL, the desc refers to the logical node." />
    </DOType>
