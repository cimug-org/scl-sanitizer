    <DOType cdc="SPC" id="SPC_SIMPLE_DIRECT" desc="Controllable single point (SPC)">
      <DA fc="ST" name="origin" bType="Struct" type="SE_Originator_P5_V001" />
      <DA fc="ST" name="ctlNum" bType="INT8U" desc="Control sequence number" />
      <DA dchg="true" fc="OR" name="opRcvd" bType="BOOLEAN" desc="indicates that an operate command for a controllable data object has been received" />
      <DA dchg="true" fc="OR" name="opOk" bType="BOOLEAN" desc="indicates that an operate command for a controllable data object has been evaluated and accepted" />
      <DA fc="OR" name="tOpOk" bType="Timestamp" desc="The timestamp when opOk becomes true" />
      <DA dchg="true" fc="CF" name="ctlModel" bType="Enum" valKind="RO" type="SE_ctlModel_V001" valImport="false" desc="Specifies the control model of IEC 61850-7-2 that corresponds to the behaviour of the data.  NOTE 2 If a data instance of a control class has no status information associated, then the attribute stVal does not exist. In that case, the value range for ctlModel is restricted to direct-with-normal-security and sbo-with-normal-security.">
        <Val>direct-with-normal-security</Val>
      </DA>
      <DA fc="DC" name="d" bType="VisString255" valKind="RO" valImport="false" desc="Textual desc of the data. In case of the common data class LPL, the desc refers to the logical node." />
      <DA fc="CO" name="Oper" bType="Struct" type="SE_Oper_P5_V001" desc="Receives service parameters and controls value." />
    </DOType>
